# Where the Minuteman FastAPI backend lives.
#
#   (unset / empty)          Same origin that served this page. Use this only if
#                            you build the Next app and let FastAPI serve it.
#   http://127.0.0.1:8000    The backend runs separately (the usual dev setup):
#                            `python backend/run.py` in one terminal,
#                            `npm run dev` here in another.
#
# When the backend is on a different origin than this app, start it with CORS open:
#   CORS_ORIGINS=http://localhost:3000 python backend/run.py
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
