# Where the Minuteman FastAPI backend lives.
#
#   (unset / empty)          Same origin that served this page. Use this only if
#                            you build a static export and let FastAPI serve it.
#   http://localhost:8000    The backend runs separately (the usual dev setup):
#                            `python backend/run.py` in one terminal,
#                            `npm run dev` here in another.
#
# Use the SAME hostname the browser uses for this app. "localhost" and
# "127.0.0.1" are different sites to a browser, and the SameSite=Lax login
# cookie is not sent across them — you would be signed out on every request.
# So with the app on http://localhost:3000, point this at localhost, not
# 127.0.0.1.
#
# The backend already allows http://localhost:3000; override CORS_ORIGINS there
# if you serve this app from somewhere else.
NEXT_PUBLIC_API_BASE=http://localhost:8000
